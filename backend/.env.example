PORT=3001
SUPABASE_URL=
# Browser-facing Supabase origin when SUPABASE_URL is the Docker Kong hostname.
SUPABASE_PUBLIC_URL=https://supabase.powersource.work
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 64-char hex AES-256-GCM key for mail and calendar secrets: openssl rand -hex 32
ENCRYPTION_KEY=

# Desktop custom protocol / loopback origins checked on OAuth returnOrigin.
APP_PUBLIC_ORIGIN=
APP_PUBLIC_ORIGIN_ALLOWLIST=

# Mail Gmail OAuth. Register this redirect on the Google Cloud OAuth client.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=https://api.powersource.work/mail/oauth/google/callback

# Calendar Google OAuth and push webhook. Same client, extra redirect + webhook.
GOOGLE_CALENDAR_REDIRECT_URI=https://api.powersource.work/calendar/oauth/google/callback
GOOGLE_CALENDAR_WEBHOOK_URL=https://api.powersource.work/calendar/webhooks/google

# Harness slim profiles on the VPS (MEMORY.md, USER.md, skills, jobs.json).
# One directory per user_id. Org skills ship in the image at /app/assets/harness/org-skills.
HERMES_PROFILES_ROOT=/var/lib/workbench/hermes-profiles
HERMES_ORG_SKILLS_ROOT=/app/assets/harness/org-skills
