PORT=3001
SUPABASE_URL=
# Browser-facing Supabase origin when SUPABASE_URL is the Docker Kong hostname.
SUPABASE_PUBLIC_URL=https://supabase.powersource.work
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# 64-char hex AES-256-GCM key for mail secrets: openssl rand -hex 32
ENCRYPTION_KEY=

# POWERSOURCE OA login form used to verify employee passwords. Accounts are not stored.
OA_VERIFY_URL=http://61.29.250.144:86/

# Desktop custom protocol / loopback origins checked on OAuth returnOrigin.
APP_PUBLIC_ORIGIN=
APP_PUBLIC_ORIGIN_ALLOWLIST=
