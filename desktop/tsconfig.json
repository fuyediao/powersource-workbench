{
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "lib": ["DOM", "DOM.Iterable", "ESNext"],
    "types": ["vite/client"],
    "allowJs": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    // Univer engine (`src/lib/univer`) is not verbatimModuleSyntax-clean upstream
    // (mixed type/value imports without an explicit `type` marker are common there).
    // Schedule-X Preact sources are excluded from this project (`exclude` below);
    // app imports typecheck against `src/lib/schedule-x/*/types`.
    "verbatimModuleSyntax": false,
    "moduleDetection": "force",
    "forceConsistentCasingInFileNames": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    // Univer engine (`@wendellhu/redi` dependency injection) uses legacy
    // constructor-parameter decorators and un-initialized-but-assigned class fields.
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "paths": {
      "@/*": ["./src/*"],
      "@univerjs/icons": ["./node_modules/@univerjs/icons/dist/esm/index.d.ts"],
      "@univerjs/core/facade": ["./src/lib/univer/shared/core/facade/index.ts"],
      "@univerjs/engine-formula/facade": ["./src/lib/univer/shared/engine-formula/facade/index.ts"],
      "@univerjs/sheets/facade": ["./src/lib/univer/excel/sheets/facade/index.ts"],
      "@univerjs/sheets-ui/facade": ["./src/lib/univer/excel/sheets-ui/facade/index.ts"],
      "@univerjs/*": [
        "./src/lib/univer/shared/*/index.ts",
        "./src/lib/univer/docs/*/index.ts",
        "./src/lib/univer/excel/*/index.ts",
        "./src/lib/univer/powerpoint/*/index.ts"
      ],
      "@schedule-x/calendar": ["./src/lib/schedule-x/calendar/types/core.d.ts"],
      "@schedule-x/react": ["./src/lib/schedule-x/react/types/index.d.ts"],
      "@schedule-x/events-service": [
        "./src/lib/schedule-x/events-service/types/core.d.ts"
      ],
      "@schedule-x/drag-and-drop": [
        "./src/lib/schedule-x/drag-and-drop/types/core.d.ts"
      ],
      "@schedule-x/resize": ["./src/lib/schedule-x/resize/types/core.d.ts"],
      "@schedule-x/shared": ["./src/lib/schedule-x/shared/types/core.d.ts"],
      "@clash-verge/app": ["./src/types/clash-verge-app.d.ts"],
      "@clash-verge/settings": ["./src/types/clash-verge-settings.d.ts"]
    }
  },
  "include": ["src"],
  "exclude": [
    "src/lib/schedule-x",
    "src/lib/mihomo",
    "src/lib/codex",
    "src/components/clash",
    "src/components/settings/sections/clash",
    "src/hooks/clash",
    "src/pages/clash",
    "src/services/clash",
    "src/types/clash",
    "src/utils/clash",
    "src/providers/clash",
    "src/constants/clash-app-version.ts"
  ],
  "references": [{ "path": "./tsconfig.node.json" }]
}
